# Copy this file outside Git, replace every example path, and source the copy.
export FIGHI_PROJECT_ROOT="/project/YOUR_PROJECT/fighi-analysis"
export FIGHI_ENV_PREFIX="/project/YOUR_PROJECT/fighi/.conda/fighi-arc"

export FIGHI_PLINK_INPUT="/secure/YOUR_PROJECT/qc/cohort"
export FIGHI_PLINK_INPUT_TYPE="pgen"
export FIGHI_CANDIDATES="$FIGHI_PROJECT_ROOT/design/candidates.txt"
export FIGHI_KEEP_FILE="$FIGHI_PROJECT_ROOT/design/keep.txt"
export FIGHI_PHENOTYPE_FILE="/secure/YOUR_PROJECT/phenotypes.tsv"
export FIGHI_PHENOTYPE_COLUMN="case"
export FIGHI_IID_COLUMN="IID"
export FIGHI_COVARIATES="age,sex,PC1,PC2,PC3,PC4"
export FIGHI_PREPARED_DIR="$FIGHI_PROJECT_ROOT/work/prepared"

export FIGHI_TRAIT="binary"
export FIGHI_FEATURE_FILE="$FIGHI_PREPARED_DIR/fighi_candidates.txt"
export FIGHI_TOP_M="100"
export FIGHI_MAX_ORDER="2"
export FIGHI_SCREEN_METHOD="all"
export FIGHI_DISCOVERY_FRACTION="0.40"
export FIGHI_CORRECTION="fdr_bh"
export FIGHI_ALPHA="0.05"
export FIGHI_SEED="2026"
